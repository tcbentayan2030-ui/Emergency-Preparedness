def main():
    print("Welcome to our game where we will test your ability to make the right decisions during disasters.")
    print("Pick a disaster (enter 1-3): 1. Earthquake 2. Typhoon 3. Flood")
    disaster = input()
    print("Choose a setting (home / school / street): ")
    setting = input()

    if disaster == "1" and (setting == "home" or setting == "school"):
        earthquake(setting)
    if disaster == "1" and setting == "street":
        earthquakestreet()

    if disaster == "2" and setting == "home":
        typhoonhome()
    if disaster == "2" and setting == "school":
        typhoonschool()

    if disaster == "3" and setting == "home":
        floodhome()
    if disaster == "3" and setting == "school":
        floodschoool()
    if disaster == "3" and setting == "street":
        floodstreet()


def earthquake(setting):
    print("You are at", setting, "and the ground starts shaking aggressively! What do you do? (enter 1-2)")
    print("1. Hide under a sturdy table and cover your head.")
    print("2. Run outside to find adults and seek guidance.")
    choice1 = input()

    if choice1 == "1":
        print("The shaking intensifies! What do you do? (enter 1-2)")
        print("1. Curl up and protect your head and neck.")
        print("2. Rush outside to seek help.")
        choice2 = input()

        if choice2 == "1":
            print("The ground stopped shaking. You avoided broken glass and falling debris. You survived with no injuries!")
        else:
            print("You tripped while running outside and debris fell on you! You survived but were heavily injured.")
    else:
        print("You fell and twisted your ankle while running outside. What do you do? (enter 1-2)")
        print("1. Keep running outside for help.")
        print("2. Duck away from windows and crawl under a sturdy structure.")
        choice3 = input()

        if choice3 == "1":
            print("You make it outside... but a car loses control and hits you.")
            print("You died.")
        else:
            print("The shaking stops. Your ankle aches but you're safe. You eventually get medical attention. Good job!")


