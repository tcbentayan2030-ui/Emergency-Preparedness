    if choice == "1":
        floodhome()
    else:
        print("You hide inside a classroom.")
        print("Rainwater leaks through windows, but the school stays stable.")
        print("After hours of waiting, rescue teams arrive.")
        print("You survived.")


def floodhome():
    print("Rain pours heavily outside. Water starts rising in your home. What do you do? (enter 1-2)")
    print("1. Move valuables upstairs and switch off electricity.")
    print("2. Run outside to look for help.")
    choice = input()

    if choice == "1":
        print("Water continues rising. What now? (enter 1-2)")
        print("1. Stay upstairs and wait for rescue.")
        print("2. Climb to the roof.")
        choice2 = input()

        if choice2 == "1":
            print("Rescue teams arrive by boat. You survived!")
        else:
            print("You climb to the roof. After hours, rescuers spot you. You survived!")
    else:
        print("The current is strong! You are swept away...")
        print("You died.")


def floodschool():
    print("It is raining heavily. Water starts entering the school hallways.")
    print("Teachers advise everyone to go home immediately. What do you do? (enter 1-2)")
    print("1. Go home as instructed.")
    print("2. Hide inside the school.")
    choice = input()

    if choice == "1":
        floodhome()
    else:
        print("You stay inside a classroom on the second floor.")
        print("Floodwaters rise only on the first floor.")
        print("Rescuers arrive later. You survived!")


def floodstreet():
    print("You are outside and streets start to flood quickly! What do you do? (enter 1-2)")
    print("1. Try to go home immediately.")
    print("2. Climb to higher ground and wait.")
    choice = input()

    if choice == "1":
        floodhome()
    else:
        print("You climb somewhere high. The water rises but doesn’t reach you.")
        print("Rescue teams arrive. You survived!")


# Start the program
main()
