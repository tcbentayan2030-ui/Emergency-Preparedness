def earthquake(setting):
    print("You are at", setting, "and the ground starts shaking aggressively! What do you do? (enter 1-2)")
    print("1. Hide under a sturdy table and cover your head.")
    print("2. Run outside to find adults and seek guidance.")
    choice1 = input("Enter your choice: ")

    if choice1 == "1":
        print("The shaking intensifies! What do you do? (enter 1-2)")
        print("1. Curl up and protect your head and neck.")
        print("2. Rush outside to seek help from adults.")
        choice2 = input("Enter your choice: ")

        if choice2 == "1":
            print("The ground stopped shaking. You were protected from broken glass and falling debris. You survived with no injuries!")
        else:
            print("You tripped while running outside and debris fell on you! You were heavily injured.")

    else:
        print("You fell and twisted your ankle while running outside. What do you do? (enter 1-2)")
        print("1. Keep running to get out of the house and seek medical attention.")
        print("2. Duck and stay away from windows. Crawl under a sturdy structure and protect your head.")
        choice3 = input("Enter your choice: ")

        if choice3 == "1":
            print("You finally made it outside.")
            print("Look out! A car lost control and it's coming for you!")
            print("... You died.")
        else:
            print("The ground stopped shaking. Your ankle aches but you were safe. You eventually received medical attention. Good job!")

