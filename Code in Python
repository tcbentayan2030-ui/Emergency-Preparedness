def main():
    print("Welcome to our game where we will test your ability to make the right decisions during disasters.")
    print("Pick a disaster (enter 1-3): 1. Earthquake 2. Typhoon 3. Flood")
    disaster = input("Enter your choice: ").strip()

    print("Choose a setting (home / school / street): ")
    setting = input("Enter your setting: ").strip().lower()

    scenario_map = {
        ("1", "home"): earthquakehome,
        ("1", "school"): earthquakeschool,
        ("1", "street"): earthquakestreet,

        ("2", "home"): typhoonhome,
        ("2", "school"): typhoonschool,
        ("2", "street"): typhoonstreet,

        ("3", "home"): floodhome,
        ("3", "school"): floodschool,
        ("3", "street"): floodstreet,
    }

    key = (disaster, setting)

    if key in scenario_map:
        scenario_map[key]()
    else:
        print("Invalid disaster or setting.")
        retry()

def get_choice(prompt, valid_choices):
    while True:
        choice = input(prompt).strip()
        if choice in valid_choices:
            return choice
        print("Invalid choice. Try again.")

def retry():
    while True:
        answer = input("Do you want to play again? (yes/no): ").strip().lower()

        if answer == "yes":
            print("- " * 10)
            main()
            break
        elif answer == "no":
            print("Thank you for playing. Stay safe!")
            break
        else:
            print("Invalid. Try again.")

def earthquakehome():
    print("You are at home and the ground starts shaking aggressively! What do you do? (enter 1-2)")
    print("1. Hide under a sturdy table and cover your head.")
    print("2. Find adults and seek guidance outside.")
    choice1 = get_choice("Enter your choice: ", ["1", "2"])

    if choice1 == "1":
        print("The shaking intensifies! What do you do? (enter 1-2)")
        print("1. Curl up and protect your head and neck.")
        print("2. Seek help from adults outside.")
        choice2 = get_choice("Enter your choice: ", ["1", "2"])

        if choice2 == "1":
            print("The ground stopped shaking. You protected your head from broken glass and falling debris. You survived with no injuries!")
            print("Great job! Always protect your head and neck with your arms or an object.")
            retry()
        else:
            print("You tripped while running outside and debris fell on you! You were heavily injured.")
            print("Tip: Never try to run outside during an earthquake.")
            retry()

    else:
        print("You fell and twisted your ankle while running outside. What do you do? (enter 1-2)")
        print("1. Keep running to get out of the building and seek medical attention.")
        print("2. Duck and stay away from windows. Crawl under a sturdy structure and protect your head.")
        choice3 = get_choice("Enter your choice: ", ["1", "2"])

        if choice3 == "1":
            print("You finally made it outside.")
            print("Look out! A car lost control and it's coming for you!")
            print("... You died.")
            print("Tip: Never try to run outside during an earthquake. Car crashes are likely during and after earthquakes.")
            retry()
        else:
            print("The ground stopped shaking. Your ankle aches but you were safe. You eventually received medical attention.")
            print("Tip: Do not attempt to run during an earthquake. Always prioritize your safety in your current location to reduce injuries.")
            retry()

