        print("Debris hits your head at the entrance! What do you do? (enter 1-2)")
        print("1. Crawl to a sturdy structure inside.")
        print("2. Go back outside.")
        choice5 = input()

        if choice5 == "1":
            print("Glass shatters but you remain safe. You survive with a minor head injury.")
        else:
            print("You are hit by more debris and glass. You wake up in a hospital. You survived.")
    if choice4 == "3":
        print("A pile of debris hits you. You lose consciousness and never wake up again.")


def typhoonhome():
    print("Thick, dark clouds overshadow the sky. What do you do? (enter 1-2)")
    print("1. Watch the news with your family.")
    print("2. Distract yourself by playing games.")
    choice6 = input()

    if choice6 == "1":
        print("The news says a typhoon is coming. You are told to pack an emergency kit.")
        print("You packed essentials. What now? (enter 1-2)")
        print("1. Run outside to find authorities.")
        print("2. Unplug outlets and go upstairs.")
        choice7 = input()

        if choice7 == "1":
            print("The wind is strong. A tree falls toward you...")
            print("You died.")
        else:
            typhoon_upstairs(has_kit=True)

    else:
        print("You didn’t notice water entering the house! What now? (enter 1-2)")
        print("1. Run outside to find help.")
        print("2. Unplug outlets and go upstairs.")
        choice9 = input()

        if choice9 == "1":
            print("A tree falls toward you...")
            print("You died.")
        else:
            typhoon_upstairs(has_kit=False)


def typhoon_upstairs(has_kit):
    print("Water starts rising, but you made it upstairs safely.")
    print("What now? (enter 1-3)")
    print("1. Watch news on phone or radio.")
    print("2. Watch news on TV.")
    print("3. Open the window to look outside.")
    choice8 = input()

    if choice8 == "1":
        print("The news says the typhoon will last two more days.")
        if has_kit:
            print("You had food and water. You survived perfectly!")
        else:
            print("You had no food or water. You survived but were dehydrated and starving.")
    if choice8 == "2":
        print("You plug in the TV. A power surge electrocutes you.")
        print("You died.")
    if choice8 == "3":
        print("The window shatters and injures you.")
        if has_kit:
            print("You used your first aid supplies and survived the typhoon with minor cuts.")
        else:
            print("You had no first aid. You survived but nearly got an infected wound.")


def typhoonschool():
    print("Strong winds roar outside. Teachers announce that students must go home immediately.")
